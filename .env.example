# Optional local overrides. The application works with the local Codex provider
# and its built-in SQLite path when this file is not copied to .env.
TUTOR_PROVIDER=codex
CODEX_COMMAND=codex.cmd
TUTOR_TIMEOUT_SECONDS=120

# OpenAI-compatible API mode. Keep real credentials only in ignored .env.
OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5

# Optional Polza.ai mode.
POLZA_API_KEY=replace_me
POLZA_MODEL=openai/gpt-4o-mini
POLZA_BASE_URL=https://polza.ai/api/v1
